APP_CONFIG__DB__URL=postgresql+asyncpg://user:pass@localhost:5432/postgres
APP_CONFIG__DB__ECHO=1
APP_CONFIG__GUNICORN__WORKERS=1
# AMQP broker URL.  In docker-compose the host must be the service name
# "rabbitmq".  Credentials are never committed — supply via environment or a
# local .env file that is not tracked by git.
APP_CONFIG__FASTSTREAM__URL=amqp://${RABBITMQ_USER:-user}:${RABBITMQ_PASSWORD}@rabbitmq:5672//
APP_CONFIG__DB_LIMIT_TASKS_RESULT=100
APP_CONFIG__API_KEYS=testkey_0_a:0,testkey_1_b:1
APP_CONFIG__WEBHOOK__MAX_PER_ORG=3
APP_CONFIG__WEBHOOK__TIMEOUT=10.0
APP_CONFIG__WEBHOOK__MAX_RETRIES=2

# ── FastStream host-rewrite settings ──────────────────────────────────────
# If the configured broker URL points at an external host (i.e. NOT one of:
# rabbitmq, localhost, 127.0.0.1, host.docker.internal), the host and port are
# automatically rewritten to COMPOSE_HOST:COMPOSE_PORT at startup.
# Set to false to disable this behaviour.
APP_CONFIG__FASTSTREAM__REWRITE_EXTERNAL_HOST_TO_COMPOSE=true
APP_CONFIG__FASTSTREAM__COMPOSE_HOST=rabbitmq
APP_CONFIG__FASTSTREAM__COMPOSE_PORT=5672

# ── FastStream startup retry / backoff settings ────────────────────────────
# broker.start() is retried up to CONNECT_MAX_RETRIES times (-1 = infinite)
# using exponential backoff with jitter.
APP_CONFIG__FASTSTREAM__CONNECT_MAX_RETRIES=30
APP_CONFIG__FASTSTREAM__CONNECT_INITIAL_DELAY=0.5
APP_CONFIG__FASTSTREAM__CONNECT_MAX_DELAY=10.0
APP_CONFIG__FASTSTREAM__CONNECT_BACKOFF_FACTOR=2.0
APP_CONFIG__FASTSTREAM__CONNECT_JITTER=0.2
# Per-attempt timeout in seconds (0 = no timeout).
APP_CONFIG__FASTSTREAM__CONNECT_TIMEOUT=5.0