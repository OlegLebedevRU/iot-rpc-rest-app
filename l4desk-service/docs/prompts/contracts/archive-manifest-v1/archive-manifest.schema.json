{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l4desk.org/schemas/archive-manifest-v1.json",
  "title": "L4Desk Archive Manifest Contract 1.0.0",
  "description": "Canonical immutable JSON Schema for monthly archive batches across IoT, media, and MenuBuilder",
  "type": "object",
  "required": [
    "archive_manifest_version",
    "archive_batch_id",
    "owner_project",
    "schema_version",
    "created_at_utc",
    "source_month",
    "time_range",
    "record_types",
    "record_counts",
    "files",
    "compression",
    "state",
    "retention",
    "storage_layout"
  ],
  "properties": {
    "archive_manifest_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "archive_batch_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{8,128}$",
      "description": "Unique archive batch identifier (String(128))"
    },
    "owner_project": {
      "type": "string",
      "enum": ["iot-rpc-rest-app", "l4media", "MenuBuilder"],
      "description": "Originating project owning the archived records"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.]+)?$",
      "description": "SemVer schema revision of the payload format"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of archive batch initialization"
    },
    "source_month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
      "description": "Calendar month in YYYY-MM format (must be older than 3 full calendar months)"
    },
    "time_range": {
      "type": "object",
      "required": ["min_occurred_at", "max_occurred_at"],
      "properties": {
        "min_occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "max_occurred_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "cursor_bounds": {
      "type": ["object", "null"],
      "properties": {
        "min_cursor": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "max_cursor": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "through_cursor": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "consumers_passed_cursor": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "record_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "List of record types enclosed in this archive batch"
    },
    "record_counts": {
      "type": "object",
      "required": ["total_records"],
      "properties": {
        "total_records": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256", "record_count", "compression"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "record_count": {
            "type": "integer",
            "minimum": 0
          },
          "compression": {
            "type": "string",
            "enum": ["gzip", "none"]
          }
        },
        "additionalProperties": false
      }
    },
    "compression": {
      "type": "string",
      "enum": ["gzip"],
      "description": "Compression format used for payload data files (MVP: gzip)"
    },
    "state": {
      "type": "string",
      "enum": ["prepared", "verified", "purged", "failed"],
      "description": "Current lifecycle state of the archive batch"
    },
    "verification": {
      "type": ["object", "null"],
      "properties": {
        "verified_at_utc": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "verifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reread_records_count": {
          "type": "integer",
          "minimum": 0
        },
        "reread_checksum_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "restore_sample_status": {
          "type": "string",
          "enum": ["passed", "failed", "skipped"]
        },
        "cursor_guard_passed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "purge": {
      "type": ["object", "null"],
      "properties": {
        "purged_at_utc": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "purged_records_count": {
          "type": "integer",
          "minimum": 0
        },
        "purge_status": {
          "type": "string",
          "enum": ["completed", "pending", "failed", "skipped"]
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "CHECKSUM_MISMATCH",
            "COUNT_MISMATCH",
            "CURSOR_LAG_DETECTED",
            "RESTORE_SAMPLE_FAILED",
            "HOT_RETENTION_VIOLATION",
            "DISK_SPACE_EXHAUSTED",
            "VOLUME_UNAVAILABLE",
            "ACTIVE_RECORDS_DETECTED",
            "ATOMIC_RENAME_FAILED",
            "PURGE_OPERATION_FAILED"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["code", "message", "occurred_at_utc"],
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "required": ["retain_until_utc", "retention_years", "backup_required"],
      "properties": {
        "retain_until_utc": {
          "type": "string",
          "format": "date-time"
        },
        "retention_years": {
          "type": "integer",
          "minimum": 3
        },
        "backup_required": {
          "type": "boolean",
          "const": true
        }
      },
      "additionalProperties": false
    },
    "storage_layout": {
      "type": "object",
      "required": ["volume_root", "relative_path"],
      "properties": {
        "volume_root": {
          "type": "string",
          "minLength": 1
        },
        "relative_path": {
          "type": "string",
          "pattern": "^[0-9]{4}/(0[1-9]|1[0-2])/[a-zA-Z0-9_-]+/[a-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": { "const": "verified" }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "type": "object",
            "required": ["verified_at_utc", "restore_sample_status", "cursor_guard_passed"],
            "properties": {
              "verified_at_utc": { "type": "string" },
              "restore_sample_status": { "const": "passed" },
              "cursor_guard_passed": { "const": true }
            }
          }
        },
        "required": ["verification"]
      }
    },
    {
      "if": {
        "properties": {
          "state": { "const": "purged" }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "type": "object",
            "required": ["verified_at_utc", "restore_sample_status", "cursor_guard_passed"],
            "properties": {
              "verified_at_utc": { "type": "string" },
              "restore_sample_status": { "const": "passed" },
              "cursor_guard_passed": { "const": true }
            }
          },
          "purge": {
            "type": "object",
            "required": ["purged_at_utc", "purge_status"],
            "properties": {
              "purged_at_utc": { "type": "string" },
              "purge_status": { "const": "completed" }
            }
          }
        },
        "required": ["verification", "purge"]
      }
    },
    {
      "if": {
        "properties": {
          "state": { "const": "failed" }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "occurred_at_utc"]
          }
        },
        "required": ["error"]
      }
    }
  ],
  "additionalProperties": false
}
