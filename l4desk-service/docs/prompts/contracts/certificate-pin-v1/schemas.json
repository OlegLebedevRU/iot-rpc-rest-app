{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certificate PIN wire contract 1.0.0",
  "$defs": {
    "IssueRequest": {
      "type": "object",
      "required": ["operation_id", "tenant_id", "terminal_id", "sn"],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "correlation_id": {"type": ["string", "null"], "maxLength": 128, "default": null},
        "tenant_id": {"type": "integer"},
        "terminal_id": {"type": "integer"},
        "sn": {"type": "string", "minLength": 1, "maxLength": 100},
        "ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 2592000, "default": 86400},
        "actor": {"type": ["string", "null"], "maxLength": 128, "default": "system"}
      },
      "additionalProperties": true
    },
    "IssueResponse": {
      "type": "object",
      "required": ["operation_id", "correlation_id", "tenant_id", "terminal_id", "sn", "pin", "pin_masked", "status", "expires_at", "created_at", "replayed"],
      "properties": {
        "operation_id": {"type": "string"},
        "correlation_id": {"type": ["string", "null"]},
        "tenant_id": {"type": "integer"},
        "terminal_id": {"type": "integer"},
        "sn": {"type": "string"},
        "pin": {"type": ["string", "null"], "pattern": "^[0-9]{6}$"},
        "pin_masked": {"type": "string"},
        "status": {"enum": ["issued", "consumed", "expired"]},
        "expires_at": {"type": "string", "format": "date-time"},
        "created_at": {"type": "string", "format": "date-time"},
        "replayed": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "issued"}}}, "then": {"properties": {"pin": {"type": "string"}}}, "else": {"properties": {"pin": {"type": "null"}}}}
      ],
      "additionalProperties": true
    },
    "ErrorResponse": {
      "type": "object",
      "required": ["detail"],
      "properties": {
        "detail": {
          "type": "object",
          "required": ["error", "message", "error_code"],
          "properties": {
            "error": {"type": "string"},
            "message": {"type": "string"},
            "error_code": {"type": "string"},
            "operation_id": {"type": "string"}
          },
          "oneOf": [
            {"properties": {"error": {"const": "unauthorized"}, "error_code": {"const": "SERVICE_AUTH_FAILED"}}, "not": {"required": ["operation_id"]}},
            {"properties": {"error": {"const": "terminal_not_found"}, "error_code": {"const": "TERMINAL_NOT_FOUND"}}, "required": ["operation_id"]},
            {"properties": {"error": {"const": "tenant_ownership_mismatch"}, "error_code": {"const": "TENANT_OWNERSHIP_MISMATCH"}}, "required": ["operation_id"]},
            {"properties": {"error": {"const": "serial_number_mismatch"}, "error_code": {"const": "SERIAL_NUMBER_MISMATCH"}}, "required": ["operation_id"]},
            {"properties": {"error": {"const": "operation_id_conflict"}, "error_code": {"const": "OPERATION_ID_CONFLICT"}}, "required": ["operation_id"]},
            {"properties": {"error": {"const": "operation_not_found"}, "error_code": {"const": "OPERATION_NOT_FOUND"}}, "required": ["operation_id"]}
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "ValidationErrorResponse": {
      "type": "object",
      "required": ["detail"],
      "properties": {
        "detail": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["loc", "msg", "type"],
            "properties": {
              "loc": {"type": "array", "items": {"type": ["string", "integer"]}},
              "msg": {"type": "string"},
              "type": {"type": "string"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}