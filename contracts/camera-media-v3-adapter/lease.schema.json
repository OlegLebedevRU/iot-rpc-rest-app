{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:leo4:camera-media-v3-adapter:lease:1.0",
  "title": "CameraLeaseView12",
  "type": "object",
  "additionalProperties": false,
  "required": ["sn", "lease_id", "active", "scope", "owner_user_id", "owner_session_id", "expires_at", "media_lease_expires_at", "media_remaining_ms", "media_clock_id"],
  "properties": {
    "sn": {"type": "string"},
    "lease_id": {"type": "string"},
    "active": {"const": true},
    "scope": {"const": "stream"},
    "owner_user_id": {"type": "string"},
    "owner_session_id": {"type": "string"},
    "expires_at": {"type": "string", "format": "date-time"},
    "media_lease_expires_at": {"type": "integer", "minimum": 1},
    "media_remaining_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
    "media_clock_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  }
}
