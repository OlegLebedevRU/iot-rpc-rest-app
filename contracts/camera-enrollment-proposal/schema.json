          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        "enrollment_id": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        "ctl_revision": {
          "const": "camera-ctl-monotonic/0.2.0-proposed"
        },
        "server_challenge": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        "issuer_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issuer_epoch": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        "binding_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "admission_floor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
