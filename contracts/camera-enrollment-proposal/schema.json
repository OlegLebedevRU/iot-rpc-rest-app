{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "type",
        "sn",
        "boot_id",
        "enrollment_id",
        "supported_ctl",
        "admission_high_water"
      ],
      "properties": {
        "revision": {
          "const": "camera-enrollment/0.1.0-proposed"
        },
        "type": {
          "const": "camera_enrollment_hello"
        },
        "sn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "boot_id": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        "enrollment_id": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        "supported_ctl": {
          "type": "array",
          "items": {
            "const": "camera-ctl-monotonic/0.2.0-proposed"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "admission_high_water": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "type",
        "sn",
        "boot_id",
        "enrollment_id",
        "ctl_revision",
        "server_challenge",
        "issuer_generation",
        "issuer_epoch",
        "binding_hash",
        "admission_floor"
      ],
      "properties": {
        "revision": {
          "const": "camera-enrollment/0.1.0-proposed"
        },
        "type": {
          "const": "camera_enrollment_offer"
        },
        "sn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
